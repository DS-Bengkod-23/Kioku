# ================================================================
# SATU-SATUNYA TEMPAT SETTING: salin file ini jadi `.env` di root repo,
# lalu ubah semua konfigurasi di sana (jangan di file lain / di dalam kode).
#
# Setelah mengubah .env:
#   - Backend/ML:  docker compose up -d backend-api celery-worker celery-beat
#   - Frontend:    docker compose up -d --build frontend
#                  (cuma untuk NEXT_PUBLIC_* / GOOGLE_CLIENT_ID; batas upload dan
#                  polling TIDAK butuh build ulang karena diambil lewat /api/v1/config)
#
# Menambah setting baru? Cukup 2 tempat: backend/app/config.py dan file ini.
# (tes backend akan gagal kalau salah satunya lupa.) Kalau modul ml/ perlu
# membacanya, tambahkan juga namanya di _ML_ENV_KEYS (tasks/process_recording.py).
# ================================================================

# ================================
# Database
# ================================
DATABASE_URL=postgresql://meetmate:meetmate@localhost:5432/meetmate

# Dipakai oleh docker-compose.yml untuk container Postgres & untuk membangun
# DATABASE_URL versi Docker (host `postgres`, bukan `localhost`). GANTI nilai
# ini (bukan cuma DATABASE_URL di atas) untuk deployment di luar localhost —
# docker-compose.yml akan menimpa DATABASE_URL secara otomatis memakai variable ini.
POSTGRES_PASSWORD=meetmate

# ================================
# Redis
# ================================
REDIS_URL=redis://:devredispass@localhost:6379

# Dipakai oleh docker-compose.yml untuk container Redis (requirepass) & untuk
# membangun REDIS_URL versi Docker (host `redis`, bukan `localhost`). GANTI nilai
# ini (bukan cuma REDIS_URL di atas) untuk deployment di luar localhost —
# docker-compose.yml akan menimpa REDIS_URL secara otomatis memakai variable ini
# kalau backend-api/celery-worker jalan lewat Docker. Tapi mode Hybrid (backend-api
# di host, lihat README) baca REDIS_URL di atas apa adanya tanpa override — makanya
# passwordnya sudah harus ikut di URL-nya dari awal.
REDIS_PASSWORD=devredispass

# ================================
# MinIO (Local Object Storage)
# ================================
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=meetmate-recordings
MINIO_SECURE=false

# Alamat MinIO yang bisa diakses langsung dari browser user (dipakai untuk
# avatar_url di <img src>, beda dari MINIO_ENDPOINT yang dipakai backend-api
# di dalam network Docker). Di docker-compose.yml sudah di-default ke
# localhost:9000 untuk dev; di prod (Cloudflare R2) biasanya sama dengan
# MINIO_ENDPOINT jadi boleh dikosongkan.
MINIO_PUBLIC_ENDPOINT=localhost:9000

# Kredensial root container MinIO (docker-compose.yml). Di setup sederhana ini,
# MINIO_ACCESS_KEY/MINIO_SECRET_KEY di atas DIPAKAI SEBAGAI kredensial root —
# jadi kalau ganti MINIO_ROOT_USER/MINIO_ROOT_PASSWORD di sini, samakan juga
# MINIO_ACCESS_KEY/MINIO_SECRET_KEY di atas.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ================================
# Email (pilih salah satu, comment/uncomment sesuai kebutuhan)
# ================================

# --- Opsi 1: Mailhog (dev lokal — email tidak terkirim, cek di http://localhost:8025) ---
SMTP_HOST=localhost
SMTP_HOST_DOCKER=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false

# --- Opsi 2: Gmail (demo/presentasi — email benar-benar terkirim ke inbox) ---
# Cara buat App Password: Google Account → Security → 2-Step Verification → App passwords
# SMTP_HOST=smtp.gmail.com
# SMTP_HOST_DOCKER=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=emailkamu@gmail.com
# SMTP_PASSWORD=xxxx xxxx xxxx xxxx
# SMTP_USE_TLS=true

# ================================
# Auth
# ================================
JWT_SECRET_KEY=your_super_secret_key_here
JWT_EXPIRE_MINUTES=1440
CHECKIN_TOKEN_EXPIRE_HOURS=24

# ================================
# Akun admin & superadmin otomatis
# ================================
# Dibuat otomatis tiap backend-api start, jadi habis `make up` / `make down-v`
# akunnya langsung ada tanpa script manual. Kosongkan = tidak dibuat.
# Sengaja kosong di file contoh ini; isi di .env (bukan di sini), lalu
# `docker compose up -d --build backend-api`.
#
# Aman dijalankan berulang: kalau emailnya sudah terdaftar, password TIDAK
# ditimpa; role hanya dinaikkan, tidak pernah diturunkan. Jadi akun kamu yang
# sudah terlanjur register bisa dijadikan superadmin lewat sini.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ================================
# Google SSO (Login with Google)
# ================================
# Client ID dari Google Cloud Console (OAuth consent screen + Web application
# credential). Dipakai untuk verifikasi signature ID token yang dikirim FE ke
# POST /auth/google — TIDAK butuh Client Secret untuk SSO (secret baru
# dibutuhkan nanti untuk Google Calendar sync, fitur terpisah).
#
# PENTING: taruh nilainya DI SINI (root .env), bukan (cuma) di
# frontend/.env.local. docker-compose.yml meneruskan variable ini sebagai
# build-arg NEXT_PUBLIC_GOOGLE_CLIENT_ID ke frontend saat `docker compose
# build` — Next.js inline semua NEXT_PUBLIC_* saat build image, bukan saat
# container jalan, dan frontend/.env.local sengaja di-exclude dari Docker
# build context (.dockerignore) jadi tidak pernah ke-baca oleh build itu.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Kill-switch — set false untuk menyembunyikan endpoint POST /auth/google
# (balikin 404) tanpa perlu revert deploy, misal kalau ada masalah di sisi Google.
GOOGLE_SSO_ENABLED=true

# ================================
# Google Calendar Sync
# ================================
# Client Secret dari OAuth Client yang sama dengan GOOGLE_CLIENT_ID di atas —
# dibutuhkan buat tukar authorization code jadi access/refresh token (beda dari
# SSO yang cuma verifikasi ID token, tidak butuh secret).
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Harus persis sama dengan salah satu "Authorized redirect URIs" di GCP Console.
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/calendar/callback

# Fernet key (32-byte urlsafe base64) buat enkripsi access_token/refresh_token
# Google yang disimpan di DB. Generate dengan:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Ganti nilai ini cuma sekali di awal — kalau diganti setelah ada user connect,
# token lama mereka tidak bisa didekripsi lagi (user harus reconnect).
GOOGLE_TOKEN_ENCRYPTION_KEY=your-generated-fernet-key

# Kill-switch — set false untuk menyembunyikan semua endpoint Calendar sync
# (connect/callback/status/disconnect balikin 404) tanpa revert deploy.
GOOGLE_CALENDAR_SYNC_ENABLED=true

# Timeout HTTP ke Google (detik) dan retry task sinkronisasi kalau Google sedang
# bermasalah. Jeda retry membesar bertahap dari BACKOFF_SECONDS sampai BACKOFF_MAX.
CALENDAR_API_TIMEOUT_SECONDS=10
CALENDAR_SYNC_MAX_RETRIES=3
CALENDAR_SYNC_RETRY_BACKOFF_SECONDS=30
CALENDAR_SYNC_RETRY_BACKOFF_MAX_SECONDS=300

# ================================
# Language Model (LLM) Provider
# ================================
# Provider aktif untuk transcribe + summary/action item extraction.
# Pilihan: 'openai' atau 'gemini'. Ganti nilai ini lalu jalankan:
#   docker compose build celery-worker && docker compose up -d celery-worker
# buat pindah provider tanpa perlu ubah kode.
LLM_PROVIDER=gemini

# Pasang diarization lokal (torch + pyannote.audio, paket paling besar di image
# worker) atau tidak. KHUSUS SAAT BUILD, bukan setting runtime: setelah mengubah
# nilai ini jalankan `make build` supaya image celery-worker dibangun ulang.
#   false = image ringan. Cukup kalau LLM_PROVIDER=gemini (Gemini melabeli speaker
#           sendiri). Kalau provider lain dipakai tanpa ini, rekaman gagal dengan
#           pesan yang jelas.
#   true  = pasang pyannote, dibutuhkan jalur OpenAI/Whisper supaya ada label speaker.
#           Model pyannote (~1-2GB) baru diunduh saat rekaman pertama diproses,
#           dan butuh HF_TOKEN di bawah.
INSTALL_LOCAL_DIARIZATION=false

# ================================
# OpenAI (dipakai kalau LLM_PROVIDER=openai)
# ================================
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_MODEL=gpt-4o-mini

# ================================
# Gemini (dipakai kalau LLM_PROVIDER=gemini)
# ================================
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.1-flash-lite

# ================================
# Timeout LLM (OpenAI & Gemini)
# ================================
# Timeout panggilan ke OpenAI/Gemini (detik). Tanpa batas ini, koneksi yang hang
# bisa memblokir worker selamanya. Transcribe lebih longgar karena request-nya
# membawa file audio; extract (summary/action item) cuma teks.
LLM_TRANSCRIBE_TIMEOUT_SECONDS=300
LLM_EXTRACT_TIMEOUT_SECONDS=120

# ================================
# Pemrosesan Rekaman (Celery)
# ================================
# Retry otomatis kalau pemrosesan gagal sementara (mis. jaringan ke OpenAI putus).
# Jeda antar-retry membesar bertahap mulai dari BACKOFF_SECONDS, maksimal BACKOFF_MAX.
PIPELINE_MAX_RETRIES=3
PIPELINE_RETRY_BACKOFF_SECONDS=60
PIPELINE_RETRY_BACKOFF_MAX_SECONDS=600

# Batas waktu total satu rekaman diproses. Sengaja longgar supaya audio 2 jam yang
# sah tidak ikut terbunuh. Soft = task diberi kesempatan cleanup, Hard = langsung
# dibunuh. Hard harus lebih besar dari Soft. Default: 3 jam / 3,5 jam.
PIPELINE_SOFT_TIME_LIMIT_SECONDS=10800
PIPELINE_TIME_LIMIT_SECONDS=12600

# ================================
# File Upload
# ================================
# Batas yang ditampilkan frontend ikut berubah otomatis (lewat GET /api/v1/config),
# tidak perlu mengubah kode frontend.
MAX_UPLOAD_SIZE_MB=200
MAX_AUDIO_DURATION_HOURS=2
ALLOWED_AUDIO_FORMATS=mp3,mp4,wav,m4a

# Hard-cap endpoint transkripsi OpenAI. Hanya berlaku kalau LLM_PROVIDER=openai:
# file di atas batas ini ditolak saat upload walau masih di bawah MAX_UPLOAD_SIZE_MB.
# Ubah hanya kalau OpenAI sendiri mengubah batasnya.
OPENAI_TRANSCRIBE_MAX_UPLOAD_MB=25

# Ukuran maksimal foto profil.
AVATAR_MAX_SIZE_MB=5

# ================================
# Polling Status Rekaman (frontend)
# ================================
# Seberapa sering halaman meeting menanyakan status pemrosesan, dan berapa lama
# sebelum berhenti dan menampilkan peringatan "pemrosesan macet".
RECORDING_POLL_INTERVAL_SECONDS=3
RECORDING_POLL_MAX_MINUTES=60

# ================================
# App
# ================================
APP_ENV=development
APP_BASE_URL=http://localhost:3000
BACKEND_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# HuggingFace Token untuk model pyannote (Diarization). Hanya dibutuhkan kalau
# INSTALL_LOCAL_DIARIZATION=true.
HF_TOKEN=hf_your_huggingface_token_here

# ================================
# Branding (kop surat notulen PDF)
# ================================
# Opsional — ada default-nya (ORG_NAME="UNIVERSITAS DIAN NUSWANTORO", ORG_LOGO_PATH
# kosong), jadi aplikasi tetap jalan normal kalau tidak diisi. Isi ini kalau notulen
# PDF perlu tampil dengan nama & logo institusi/organisasi yang berbeda.
ORG_NAME=Universitas Dian Nuswantoro

# Path ke file logo (PNG/JPG). PAKAI PATH RELATIF, taruh filenya di backend/assets/,
# misal ORG_LOGO_PATH=assets/logo.png (bukan /app/assets/logo.png).
# Kenapa relatif: backend-api dan celery-worker punya struktur folder beda di
# dalam image (lihat docs/DOCKER_CHANGES.md), path relatif otomatis resolve benar
# di keduanya karena working directory masing-masing sejajar dengan backend/.
# File di-bake ke image via COPY (tidak ada volume mount) — WAJIB `make build`
# ulang setelah menambah/ganti file logo, restart saja tidak cukup.
# Kalau file tidak ditemukan, PDF tetap render normal (cuma tanpa logo, teks saja).
ORG_LOGO_PATH=

