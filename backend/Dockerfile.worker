FROM python:3.11-slim

WORKDIR /app

# Install system dependencies including those needed for ML like ffmpeg
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    ffmpeg \
    fonts-dejavu-core \
    fonts-dejavu-extra \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements from both backend and ml
COPY backend/requirements.txt backend_requirements.txt
COPY ml/requirements.txt ml_requirements.txt
COPY ml/requirements-diarization.txt ml_requirements_diarization.txt

# Diarization lokal (torch + pyannote.audio, besar) hanya dipasang kalau
# INSTALL_LOCAL_DIARIZATION=true di .env. Tidak perlu untuk LLM_PROVIDER=gemini.
ARG INSTALL_LOCAL_DIARIZATION=false

# Install dependencies
RUN pip install --no-cache-dir -r backend_requirements.txt
RUN pip install --no-cache-dir -r ml_requirements.txt
RUN if [ "$INSTALL_LOCAL_DIARIZATION" = "true" ]; then \
        pip install --no-cache-dir -r ml_requirements_diarization.txt; \
    fi

# Copy both source directories
COPY backend/ backend/
COPY ml/ ml/

# Set PYTHONPATH so the Celery worker can import both backend/app and ml/
ENV PYTHONPATH=/app/backend:/app

WORKDIR /app/backend

CMD ["celery", "-A", "app.worker", "worker", "--loglevel=info"]
